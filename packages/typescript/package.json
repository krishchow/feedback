{
  "name": "mcp-feedback",
  "version": "0.1.0",
  "description": "Drop-in feedback tools for MCP servers: agents submit structured feedback, stamped with the caller's identity, into a pluggable store.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "feedback",
    "agents",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/krishchow/feedback#readme",
  "bugs": {
    "url": "https://github.com/krishchow/feedback/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishchow/feedback.git",
    "directory": "packages/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mcp-feedback": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/stores/sqlite.d.ts",
      "default": "./dist/stores/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "default": "./dist/stores/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:spec": "UPDATE_SPEC=1 vitest run test/spec.test.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0 || ^4.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "3.25.76"
  }
}
