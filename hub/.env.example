# Copy to hub/.env and fill in. Never commit the filled-in file.

# The hub's public URL. Tokens are valid only here, so choose it before issuing any.
MCP_FEEDBACK_INGEST_ISSUER=https://feedback.example.com

# The signing key: the whole JSON written by `npx mcp-feedback ingest keygen --out key.json`, on one line.
#   node -e "console.log(JSON.stringify(require('./key.json')))"
MCP_FEEDBACK_INGEST_KEY=

# Opens the reader tools for every project at /mcp. 32+ random characters: openssl rand -base64 32
MCP_FEEDBACK_READER_TOKEN=

# Keys token fingerprints (HMAC). Random and stable: openssl rand -base64 32
MCP_FEEDBACK_FINGERPRINT_KEY=

# Set to 1 only behind a proxy that overwrites X-Forwarded-For.
MCP_FEEDBACK_INGEST_TRUST_PROXY=1

# Optional: accept only these projects (comma-separated). Empty accepts every project the key signed.
MCP_FEEDBACK_INGEST_PROJECTS=

# Optional: token ids (jti) or subjects to refuse, comma-separated. Takes effect on restart.
MCP_FEEDBACK_INGEST_REVOKED=
